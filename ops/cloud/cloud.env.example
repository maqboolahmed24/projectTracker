# Copy OUTSIDE the checkout. Fill every blank; no secrets belong in this file.
# Use registry manifest digests, or exact image IDs after verified docker load.
UKDA_API_IMAGE=
UKDA_FRONTEND_IMAGE=
UKDA_RECOVERY_IMAGE=
UKDA_CADDY_IMAGE=
# Required by maqbool-recovery.service, with the same immutable-pin rules.
UKDA_OPERATOR_IMAGE=

# Exact permanent https://hostname, without a path or trailing slash.
UKDA_APP_ORIGIN=
UKDA_PRIMARY_PRIVATE_IP=
UKDA_BACKUP_PRIVATE_IP=
UKDA_APP_BACKUP_EXPORT=
UKDA_CONTROL_BACKUP_EXPORT=

# Absolute files managed outside Git; runtime env contains limited DB credentials
# and identity secrets, never ADMIN_DATABASE_URL or CONTROL_ADMIN_DATABASE_URL.
UKDA_RUNTIME_ENV_FILE=
# Separate limited DB URLs only; never API identity or admin keys.
UKDA_WORKER_ENV_FILE=
UKDA_APP_ADMIN_PASSWORD_FILE=
UKDA_APP_RUNTIME_PASSWORD_FILE=
UKDA_CONTROL_ADMIN_PASSWORD_FILE=
UKDA_CONTROL_RUNTIME_PASSWORD_FILE=
UKDA_DATABASE_CA_FILE=
UKDA_APP_TLS_CERT_FILE=
UKDA_APP_TLS_KEY_FILE=
UKDA_CONTROL_TLS_CERT_FILE=
UKDA_CONTROL_TLS_KEY_FILE=

# The operator uses this directory on the primary; securely provision its
# replication.pgpass and CA onto the separate standby host before starting it.
UKDA_RECOVERY_DIRECTORY=
UKDA_REPLICATION_CA_FILE=
UKDA_REPLICATION_PRIMARY_HOST=

# Export these nonsecret settings into the host operator service environment too.
# Compose's --env-file does not export variables to a separate Node process.
UKDA_RECOVERY_COMPOSE_FILE=
UKDA_RECOVERY_RECORDS_DIRECTORY=
UKDA_RECOVERY_REPLICA_MODE=external
UKDA_REPLICATION_ALLOWED_CIDR=
UKDA_REPLICATION_REQUIRE_TLS=true

# The supplied systemd unit expects this file at /opt/maqbool/secrets/cloud.env,
# a separate root-owned0600 /opt/maqbool/secrets/operator.env, the release files
# at /opt/maqbool/release/ops/cloud, and a root-owned0700 NFS mount at
# /opt/maqbool/recovery-records. See README for the distinct records export policy.
