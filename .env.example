# Local development only. Never reuse these public credentials in production.
# Start the two databases with: docker compose up -d --wait
NODE_ENV=development
HOST=127.0.0.1
PORT=3400
APP_ORIGIN=http://localhost:3400

# Runtime roles cannot create schemas, own application tables, or bypass RLS.
DATABASE_URL=postgres://ukda_app_dev:ukda_app_local_only@127.0.0.1:55432/ukda_app
CONTROL_DATABASE_URL=postgres://ukda_control_dev:ukda_control_local_only@127.0.0.1:55433/ukda_control

# Bootstrap/migration credentials belong in the separate .env.admin file.
# Run npm run identity:setup once to create .env.identity (mode 0600).
# Keep that persistent operational identity file private and backed up separately.
# For a local worker process, override PORT=3401 when invoking npm run worker.

# Production requires separately provisioned credentials and an HTTPS APP_ORIGIN.
# The development Compose file does not configure production backups or replication.
